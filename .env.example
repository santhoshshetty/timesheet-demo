# Copy to .env for Docker Compose. Placeholder values only - never commit real secrets.

# Runtime environment: development | test | staging (production is refused: FR-036)
APP_ENV=development
# HTTP port the app listens on
PORT=3000
# PostgreSQL connection string used by the app and migrations (host "db" is the Compose service)
DATABASE_URL=postgres://timesheet:change-me@db:5432/timesheet
# PostgreSQL container user
POSTGRES_USER=timesheet
# PostgreSQL container password (placeholder)
POSTGRES_PASSWORD=change-me
# PostgreSQL database name
POSTGRES_DB=timesheet
# IANA time zone that defines "today" for date rules
BUSINESS_TIME_ZONE=UTC
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /api/docs
SWAGGER_ENABLED=true

# Optional overrides - leave unset: defaults work for local development and the Docker image sets container paths
# CONTRACT_PATH=
# STATIC_DIR=
